{
  "name": "@promptscape/core",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "verify:reimplementation": "tsx src/verification/cli.ts",
    "compile:run": "tsx src/compile/cli.ts",
    "validate:metagrinder": "node scripts/validate-metagrinder-fixtures.js",
    "validate:rainy-alley-prototype": "node scripts/validate-rainy-alley-prototype.js",
    "validate:rainy-alley-shot-differences": "node scripts/validate-rainy-alley-shot-differences.js",
    "run:rainy-alley-prototype": "node scripts/run-rainy-alley-prototype.js",
    "run:metagrinder-mvp": "node scripts/run-metagrinder-mvp.js",
    "run:historical-photo-observations": "node scripts/run-historical-photo-observations.js",
    "run:metagrinder-workbench": "node scripts/serve-metagrinder-workbench.js",
    "run:workbench-thin": "tsx src/workbench/cli.ts",
    "run:community-job": "tsx src/community/cli.ts",
    "run:research-brief-lab": "node scripts/serve-research-brief-lab.js",
    "codegen:json-schema": "tsx src/schemas/emit-json-schema.ts",
    "eval:src": "tsx src/eval/run.ts",
    "eval:corpus": "tsx src/eval/run-corpus.ts",
    "eval:holdout": "tsx src/eval/run-holdout.ts",
    "eval:judge": "tsx src/eval/run-judge-gate.ts",
    "eval:questions": "tsx src/eval/questions/run-question-battery.ts",
    "test:src": "jest --config jest.src.config.cjs",
    "typecheck:src": "tsc --noEmit -p src/tsconfig.json",
    "test:metagrinder": "jest --config jest.metagrinder.config.cjs",
    "test:metagrinder:coverage": "jest --config jest.metagrinder.config.cjs --coverage"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.22.4"
  }
}
