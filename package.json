{
  "name": "prompt-spaghetti-metagrinder-fork",
  "version": "0.1.0",
  "private": true,
  "description": "Pruned Metagrinder/UTDG/PSG implementation fork",
  "license": "UNLICENSED",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "validate:metagrinder": "pnpm --filter @promptscape/core validate:metagrinder",
    "validate:rainy-alley-prototype": "pnpm --filter @promptscape/core validate:rainy-alley-prototype",
    "validate:rainy-alley-shot-differences": "pnpm --filter @promptscape/core validate:rainy-alley-shot-differences",
    "run:rainy-alley-prototype": "pnpm --filter @promptscape/core run:rainy-alley-prototype",
    "run:metagrinder-mvp": "pnpm --filter @promptscape/core run:metagrinder-mvp",
    "run:historical-photo-observations": "pnpm --filter @promptscape/core run:historical-photo-observations",
    "run:metagrinder-workbench": "pnpm --filter @promptscape/core run:metagrinder-workbench",
    "run:community-job": "pnpm --filter @promptscape/core run:community-job",
    "run:research-brief-lab": "pnpm --filter @promptscape/core run:research-brief-lab",
    "test:metagrinder": "pnpm --filter @promptscape/core test:metagrinder",
    "test:src": "pnpm --filter @promptscape/core test:src",
    "typecheck:src": "pnpm --filter @promptscape/core typecheck:src",
    "eval:src": "pnpm --filter @promptscape/core eval:src",
    "eval:corpus": "pnpm --filter @promptscape/core eval:corpus",
    "eval:holdout": "pnpm --filter @promptscape/core eval:holdout",
    "eval:judge": "pnpm --filter @promptscape/core eval:judge",
    "eval:questions": "pnpm --filter @promptscape/core eval:questions"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
