{
  "$ref": "#/definitions/eval-report",
  "definitions": {
    "eval-report": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "const": "eval-report"
        },
        "schemaVersion": {
          "type": "string",
          "default": "0.1.0"
        },
        "runId": {
          "type": "string"
        },
        "inputId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "evaluationScope": {
          "type": "object",
          "properties": {
            "scoredSignals": {
              "type": "string",
              "const": "extraction-metadata"
            },
            "factualAccuracy": {
              "type": "string",
              "const": "not-evaluated"
            },
            "downstreamSemantics": {
              "type": "string",
              "const": "not-evaluated"
            },
            "downstreamDiagnostics": {
              "type": "string",
              "enum": [
                "not-evaluated",
                "deterministic-boundaries"
              ],
              "default": "not-evaluated"
            },
            "eraInput": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "const": "single-grammar"
                },
                "runId": {
                  "type": "string"
                },
                "inputId": {
                  "type": "string"
                }
              },
              "required": [
                "scope",
                "runId",
                "inputId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "scoredSignals",
            "factualAccuracy",
            "downstreamSemantics"
          ],
          "additionalProperties": false,
          "default": {
            "scoredSignals": "extraction-metadata",
            "factualAccuracy": "not-evaluated",
            "downstreamSemantics": "not-evaluated"
          }
        },
        "pipelineDiagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "briefId": {
                "type": "string"
              },
              "runId": {
                "type": "string"
              },
              "inputId": {
                "type": "string"
              },
              "artifactHashes": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "planCount": {
                "type": "integer",
                "minimum": 0
              },
              "realizedCount": {
                "type": "integer",
                "minimum": 0
              },
              "failedRealizations": {
                "type": "integer",
                "minimum": 0
              },
              "pendingRealizations": {
                "type": "integer",
                "minimum": 0
              },
              "constraintViolations": {
                "type": "integer",
                "minimum": 0
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "briefId",
              "runId",
              "inputId",
              "artifactHashes",
              "planCount",
              "realizedCount",
              "failedRealizations",
              "pendingRealizations",
              "constraintViolations",
              "issues"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "baseline": {
          "type": "object",
          "properties": {
            "minimumScore": {
              "type": "number",
              "minimum": 0
            },
            "passed": {
              "type": "boolean"
            }
          },
          "required": [
            "minimumScore",
            "passed"
          ],
          "additionalProperties": false
        },
        "corpus": {
          "type": "object",
          "properties": {
            "corpusVersion": {
              "type": "string"
            },
            "sourceKind": {
              "type": "string",
              "enum": [
                "legacy-bootstrap",
                "replayed-extraction",
                "holdout-extraction"
              ]
            },
            "totalScore": {
              "type": "number"
            },
            "totalMax": {
              "type": "number"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "expectedMode": {
                    "type": "string"
                  },
                  "actualMode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "recommendedFocus": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "warningCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "breakdown": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "number"
                      },
                      "focus": {
                        "type": "number"
                      },
                      "rationale": {
                        "type": "number"
                      },
                      "warnings": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "mode",
                      "focus",
                      "rationale",
                      "warnings"
                    ],
                    "additionalProperties": false
                  },
                  "score": {
                    "type": "number"
                  },
                  "maxScore": {
                    "type": "number"
                  },
                  "problems": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "expectedMode",
                  "actualMode",
                  "recommendedFocus",
                  "warningCount",
                  "breakdown",
                  "score",
                  "maxScore",
                  "problems"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "corpusVersion",
            "sourceKind",
            "totalScore",
            "totalMax",
            "results"
          ],
          "additionalProperties": false
        },
        "era": {
          "type": "object",
          "properties": {
            "base": {
              "type": "object",
              "properties": {
                "evidenceCoverageBasis": {
                  "type": "string",
                  "const": "reference-presence-only",
                  "default": "reference-presence-only"
                },
                "grammarTarget": {
                  "type": "string",
                  "enum": [
                    "base",
                    "accepted"
                  ]
                },
                "seed": {
                  "type": "integer"
                },
                "sampleCountRequested": {
                  "type": "integer",
                  "minimum": 0
                },
                "sampleCountEmitted": {
                  "type": "integer",
                  "minimum": 0
                },
                "emissionRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "constraintViolationRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "lexicalDiversity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidenceCoverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "archetypeMix": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "modifierMix": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "required": [
                "grammarTarget",
                "seed",
                "sampleCountRequested",
                "sampleCountEmitted",
                "emissionRate",
                "constraintViolationRate",
                "lexicalDiversity",
                "evidenceCoverage",
                "archetypeMix",
                "modifierMix"
              ],
              "additionalProperties": false
            },
            "accepted": {
              "type": "object",
              "properties": {
                "evidenceCoverageBasis": {
                  "type": "string",
                  "const": "reference-presence-only",
                  "default": "reference-presence-only"
                },
                "grammarTarget": {
                  "type": "string",
                  "enum": [
                    "base",
                    "accepted"
                  ]
                },
                "seed": {
                  "type": "integer"
                },
                "sampleCountRequested": {
                  "type": "integer",
                  "minimum": 0
                },
                "sampleCountEmitted": {
                  "type": "integer",
                  "minimum": 0
                },
                "emissionRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "constraintViolationRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "lexicalDiversity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidenceCoverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "archetypeMix": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "modifierMix": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "required": [
                "grammarTarget",
                "seed",
                "sampleCountRequested",
                "sampleCountEmitted",
                "emissionRate",
                "constraintViolationRate",
                "lexicalDiversity",
                "evidenceCoverage",
                "archetypeMix",
                "modifierMix"
              ],
              "additionalProperties": false
            },
            "shift": {
              "type": "object",
              "properties": {
                "totalVariationDistance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "archetypeShareDelta": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "modifierShareDelta": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "lexicalDiversityDelta": {
                  "type": "number"
                },
                "evidenceCoverageDelta": {
                  "type": "number"
                },
                "emissionRateDelta": {
                  "type": "number"
                },
                "explanations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "totalVariationDistance",
                "archetypeShareDelta",
                "modifierShareDelta",
                "lexicalDiversityDelta",
                "evidenceCoverageDelta",
                "emissionRateDelta",
                "explanations"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "base"
          ],
          "additionalProperties": false
        },
        "judgeGate": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "seed": {
              "type": "integer"
            },
            "stressAccuracy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "positionConsistency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "thresholds": {
              "type": "object",
              "properties": {
                "minStressAccuracy": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minPositionConsistency": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minCalibrationAgreement": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxCalibrationMae": {
                  "type": "number",
                  "minimum": 0
                },
                "minCalibrationRatings": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "minStressAccuracy",
                "minPositionConsistency",
                "minCalibrationAgreement",
                "maxCalibrationMae",
                "minCalibrationRatings"
              ],
              "additionalProperties": false
            },
            "stressResults": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "caseId": {
                    "type": "string"
                  },
                  "initialCandidateSide": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right"
                    ]
                  },
                  "initialPreferred": {
                    "type": "string",
                    "enum": [
                      "candidate",
                      "reference",
                      "tie"
                    ]
                  },
                  "mirroredPreferred": {
                    "type": "string",
                    "enum": [
                      "candidate",
                      "reference",
                      "tie"
                    ]
                  },
                  "expectedPreferred": {
                    "type": "string",
                    "enum": [
                      "candidate",
                      "reference",
                      "tie"
                    ]
                  },
                  "correct": {
                    "type": "boolean"
                  },
                  "positionConsistent": {
                    "type": "boolean"
                  },
                  "analyticComplete": {
                    "type": "boolean"
                  },
                  "candidateScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "referenceScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "caseId",
                  "initialCandidateSide",
                  "initialPreferred",
                  "mirroredPreferred",
                  "expectedPreferred",
                  "correct",
                  "positionConsistent",
                  "analyticComplete",
                  "candidateScore",
                  "referenceScore"
                ],
                "additionalProperties": false
              }
            },
            "calibration": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "missing",
                    "pass",
                    "fail"
                  ]
                },
                "ratingCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "preferenceAgreement": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "meanAbsoluteError": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "status",
                "ratingCount",
                "preferenceAgreement",
                "meanAbsoluteError"
              ],
              "additionalProperties": false
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "passed",
            "seed",
            "stressAccuracy",
            "positionConsistency",
            "thresholds",
            "stressResults",
            "calibration",
            "failures"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "artifact",
        "runId",
        "inputId",
        "createdAt",
        "corpus",
        "era"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
