{
  "$ref": "#/definitions/import-receipt",
  "definitions": {
    "import-receipt": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "const": "import-receipt"
        },
        "schemaVersion": {
          "type": "string",
          "default": "0.1.0"
        },
        "receiptId": {
          "type": "string"
        },
        "packageId": {
          "type": "string"
        },
        "contentSha256": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "consumerRef": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "imported",
            "partially_imported",
            "rejected"
          ]
        },
        "notes": {
          "type": "string"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "artifact",
        "receiptId",
        "packageId",
        "contentSha256",
        "consumer",
        "status",
        "receivedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
