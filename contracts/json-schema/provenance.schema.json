{
  "$ref": "#/definitions/provenance",
  "definitions": {
    "provenance": {
      "type": "object",
      "properties": {
        "sourceInputIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "sourceChunkIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunkId": {
                "type": "string"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "chunkId",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "excerptText": {
          "type": "string"
        },
        "attributionMode": {
          "type": "string",
          "enum": [
            "quoted",
            "paraphrased",
            "inferred",
            "web_retrieved"
          ]
        },
        "evidenceBasis": {
          "type": "string",
          "enum": [
            "observed",
            "text_supported",
            "external_research",
            "proxy_analysis",
            "inferred",
            "generated"
          ],
          "default": "inferred"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "low"
        },
        "verification": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "downgraded",
            "rejected"
          ],
          "default": "unverified"
        },
        "reasoningNote": {
          "type": "string"
        }
      },
      "required": [
        "attributionMode"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
